{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jtk25.my.id/schemas/schedule-class.json",
  "title": "Schedule Class",
  "description": "Jadwal tetap per kelas untuk satu semester",
  "type": "object",
  "required": ["schema", "semester", "updatedAt", "data"],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2,
      "description": "Schema version, always 2"
    },
    "semester": {
      "type": "string",
      "pattern": "^\\d{4}/\\d{4}-(GANJIL|GENAP)$",
      "description": "Semester identifier, e.g. 2026/2027-GANJIL"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "data": {
      "type": "object",
      "required": ["class_name", "schedule"],
      "properties": {
        "class_name": {
          "type": "string",
          "pattern": "^D[34]-\\d+[A-Z](-\\w+)?$",
          "description": "Class identifier, e.g. D3-2A, D4-2A"
        },
        "schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DaySchedule"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DotTime": {
      "type": "string",
      "pattern": "^\\d{2}\\.\\d{2}-\\d{2}\\.\\d{2}$",
      "description": "Time slot in dot notation, e.g. 07.00-07.50"
    },
    "Day": {
      "type": "string",
      "enum": ["SENIN", "SELASA", "RABU", "KAMIS", "JUMAT", "SABTU", "MINGGU"],
      "description": "Day of the week in Bahasa Indonesia"
    },
    "CourseType": {
      "type": "string",
      "enum": ["TE", "PR"],
      "description": "Course type: TE (Teori) or PR (Praktek)"
    },
    "Session": {
      "type": "object",
      "required": ["time", "course_code", "course_name", "type", "lecturer_code", "lecturer", "room"],
      "properties": {
        "time": {
          "$ref": "#/$defs/DotTime"
        },
        "course_code": {
          "type": "string",
          "pattern": "^25(IF|TI|KU|IG|MM)\\d{4}$",
          "description": "Course code, e.g. 25IF2116, 25TI2103, 25KU1008"
        },
        "course_name": {
          "type": "string",
          "minLength": 1,
          "description": "Course name"
        },
        "type": {
          "$ref": "#/$defs/CourseType"
        },
        "lecturer_code": {
          "type": "string",
          "minLength": 1,
          "description": "Lecturer code(s), comma-separated for multiple lecturers"
        },
        "lecturer": {
          "type": "string",
          "minLength": 1,
          "description": "Lecturer name(s), comma-separated for multiple lecturers"
        },
        "room": {
          "type": "string",
          "minLength": 1,
          "description": "Room identifier, e.g. D108-Kelas, H501-Lab. T"
        }
      },
      "additionalProperties": false
    },
    "DaySchedule": {
      "type": "object",
      "required": ["day", "sessions"],
      "properties": {
        "day": {
          "$ref": "#/$defs/Day"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        }
      },
      "additionalProperties": false
    }
  }
}

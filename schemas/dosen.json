{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jtk25.my.id/schemas/dosen.json",
  "title": "Dosen",
  "description": "Daftar dosen JTK25",
  "type": "object",
  "required": ["schema", "semester", "updatedAt", "data"],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2
    },
    "semester": {
      "type": "string",
      "pattern": "^\\d{4}/\\d{4}-(GANJIL|GENAP)$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Dosen"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Dosen": {
      "type": "object",
      "required": ["code", "name"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Lecturer code, e.g. AD, AP, DC"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Full name with title"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Optional email"
        }
      },
      "additionalProperties": false
    }
  }
}
